# ==========================================
# TaskTracker Backend Environment Variables
# ==========================================

# Server Port (Dynamic platform port or local default)
PORT=8080

# PostgreSQL Database Connection
# Local Docker default: jdbc:postgresql://localhost:5555/tasktracker_db
# Cloud/Remote example: jdbc:postgresql://<db-host>:<port>/<database-name>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5555/tasktracker_db
DATABASE_USERNAME=root
DATABASE_PASSWORD=password

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JPA & Hibernate Settings (Optional)
# Options for JPA_DDL_AUTO: update, validate, none, create, create-drop
JPA_DDL_AUTO=update
SHOW_SQL=true

# Local Docker Compose PostgreSQL (Optional overrides for docker-compose.yml)
POSTGRES_DB=tasktracker_db
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_PORT=5555
